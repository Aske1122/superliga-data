```{=html}
<%
// Arkiv: dato · rubrik · titel · resumé · lille udgave af hovedgrafen.
// metadataAttrs(item) skal stå på hver række, så kategorifilteret virker.
const rubrik = (item) => (item.categories && item.categories.length) ? item.categories[0] : "";
const rubrikFarve = (t) => { let h = 0; for (const c of t) h = (h * 31 + c.charCodeAt(0)) % 997; return h % 4; };
const minutter = (item) => item.laesetid ? item.laesetid + "'" : "";   // fra scripts/foer_render.py
const rubrikHTML = (item) => rubrik(item) ? `<div class="rubrik" data-farve="${rubrikFarve(rubrik(item))}"><span class="rubrik-minut">${minutter(item)}</span><span class="rubrik-tekst">${rubrik(item)}</span></div>` : "";
%>
<div class="list artikel-liste">
<% for (const item of items) { %>
  <a class="artikel<%= item.image ? '' : ' uden-billede' %>" href="<%- item.path %>" <%= metadataAttrs(item) %>>
    <div class="artikel-dato"><%= item.date || "" %></div>
    <div>
      <%= rubrikHTML(item) %>
      <h2 class="artikel-titel"><%= item.title %></h2>
      <p class="artikel-resume"><%= item.description || item.subtitle || "" %></p>
    </div>
    <% if (item.image) { %><div class="artikel-billede"><img src="<%- item.image %>" alt="" loading="lazy"></div><% } %>
  </a>
<% } %>
</div>
```
